.cursor/
.vscode/
.DS_Store

# ============================================================
# Data（本地数据集，不入库）
# ============================================================
data/*

# ============================================================
# Model weights / checkpoints（本地保存，不入库）
# 各模型的预训练权重说明见对应目录下的 pretrained_ckpt/README.md
# 统一权重仓：pretrained_weights/（保留 README）
# ============================================================
*.pth
*.pt
*.bin
*.npz
checkpoint/
checkpoints/
model_out/
pretrained_weights/**
!pretrained_weights/README.md
!pretrained_weights/download_sam3.py

# ============================================================
# Experiment / run outputs（训练与分析产物，不入库）
# ============================================================
experiments/*/*/*/runs/
experiments/*/*/*/runs_2/
experiments/*/*/runs/
experiments/*/*/*/outputs/
# 分割实验的运行结果目录（按模型名分组，不入库）
experiments/segment/project1_2610/SLR-UNet/
experiments/segment/project1_2610/TransUNet-Official/
test_log/
predictions/
outputs/paper_report/
*.nii
*.nii.gz
*.npy

# ============================================================
# Logs（训练日志、tensorboard 事件文件）
# ============================================================
*.log
events.out.tfevents*
# 每次训练都会改写的 Swin-Unet 日志
Swin-Unet/model_out/log.txt

# ============================================================
# Text files
# 默认忽略 *.txt（实验记录、日志等），以下依赖文件例外保留
# ============================================================
*.txt
!**/requirements*.txt
!**/lists*/**/*.txt

# ============================================================
# Misc
# ============================================================
# github source
*-main/

